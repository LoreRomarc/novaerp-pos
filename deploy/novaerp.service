[Unit]
Description=NovaERP Django application
After=network.target postgresql.service

[Service]
Type=notify
User=novaerp
Group=www-data
WorkingDirectory=/opt/novaerp-pos
EnvironmentFile=/etc/novaerp/novaerp.env
RuntimeDirectory=novaerp
RuntimeDirectoryMode=0755
ExecStart=/opt/novaerp-pos/venv/bin/gunicorn config.wsgi:application --bind unix:/run/novaerp/novaerp.sock --workers 3 --timeout 120 --access-logfile - --error-logfile -
ExecReload=/bin/kill -s HUP $MAINPID
Restart=always
RestartSec=5
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
