# Django
DJANGO_SECRET_KEY=genere_una_clave_larga_aleatoria_y_privada
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=erp.midominio.com,www.erp.midominio.com
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_HSTS_SECONDS=31536000
DJANGO_HSTS_PRELOAD=False
DJANGO_CSRF_TRUSTED_ORIGINS=https://erp.midominio.com
# Para Render/Neon u otro PostgreSQL administrado, use una sola URL:
# DATABASE_URL=postgresql://usuario:clave@host/base?sslmode=require
# Para Render active WhiteNoise durante el build:
# DJANGO_USE_WHITENOISE=True

# PostgreSQL
POSTGRES_DB=novaerp
POSTGRES_USER=novaerp_app
POSTGRES_PASSWORD=use_una_contrasena_larga_y_unica
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_CONN_MAX_AGE=60
